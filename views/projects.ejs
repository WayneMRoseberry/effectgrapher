<h2>Manage Projects</h2>
<div class="grid two-cols">
  <div>
    <h3>Add Project</h3>
    <form method="post" action="/projects/add" class="stack">
      <input type="text" name="name" placeholder="Project name" maxlength="200" required />
      <button class="btn" type="submit">Add</button>
    </form>
  </div>
  <div>
    <h3>Existing Projects</h3>
    <table class="table">
      <thead><tr><th>Name</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (projects.length === 0) { %>
          <tr><td colspan="2" class="muted">No projects yet</td></tr>
        <% } %>
        <% projects.forEach(p => { %>
          <tr>
            <td><%= p.name %></td>
            <td>
              <details class="menu">
                <summary class="btn btn-sm">Actions</summary>
                <div class="menu-items">
                  <form method="post" action="/projects/<%= p.id %>/rename">
                    <input type="text" name="name" value="<%- p.name %>" maxlength="200" required />
                    <button class="btn btn-sm" type="submit">Rename</button>
                  </form>
                  <form method="post" action="/projects/<%= p.id %>/delete" onsubmit="return confirm('Delete this project and all its data?')">
                    <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                  </form>
                </div>
              </details>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>