<% const selectedProject = projectId && projects.find(p => p.id === projectId); %>
<div class="page-header">
  <form method="get" action="/" class="inline-form">
    <label for="projectId">Project:</label>
    <select name="projectId" id="projectId" onchange="this.form.submit()">
      <% projects.forEach(p => { %>
        <option value="<%= p.id %>" <%= projectId === p.id ? 'selected' : '' %>><%= p.name %></option>
      <% }) %>
    </select>
  </form>
  <div class="header-actions">
    <% if (selectedProject) { %>
    <details class="menu">
      <summary class="btn">Charter Commands</summary>
      <div class="menu-items">
        <form method="post" action="/projects/<%= selectedProject.id %>/charters/add">
          <input type="text" name="name" placeholder="New charter name" maxlength="200" required />
          <button class="btn" type="submit">Add Charter</button>
        </form>
      </div>
    </details>
    <% } %>
  </div>
</div>

<% if (!selectedProject) { %>
  <p>No projects yet. Go to <a href="/projects">Manage Projects</a> to add one.</p>
<% } else { %>
  <h2>Testing Charters</h2>
  <table class="table">
    <thead>
      <tr>
        <th>Status</th>
        <th>Charter</th>
        <th>Sessions</th>
        <th>Most Recent Session</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (charters.length === 0) { %>
        <tr><td colspan="5" class="muted">No charters yet.</td></tr>
      <% } %>
      <% charters.forEach(c => { %>
        <tr>
          <td>
            <% if (c.session_count > 0) { %>
              <span class="status status-green" title="Has sessions"></span>
            <% } else { %>
              <span class="status status-red" title="No sessions"></span>
            <% } %>
          </td>
          <td><a href="/charters/<%= c.id %>"><%= c.name %></a></td>
          <td><%= c.session_count %></td>
          <td><%= c.last_session_date ? new Date(c.last_session_date).toLocaleString() : '-' %></td>
          <td>
            <details class="menu">
              <summary class="btn btn-sm">Actions</summary>
              <div class="menu-items">
                <form method="post" action="/charters/<%= c.id %>/rename">
                  <input type="text" name="name" value="<%- c.name %>" maxlength="200" required />
                  <button class="btn btn-sm" type="submit">Rename</button>
                </form>
                <form method="post" action="/charters/<%= c.id %>/delete" onsubmit="return confirm('Delete this charter and all sessions?')">
                  <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                </form>
              </div>
            </details>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>